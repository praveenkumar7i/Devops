
pipeline {
    agent any

    environment {
        VENV = '.venv'
        DEPLOY_DIR = 'python-app-deploy'
    }

    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                sh '''
                    python3 -m venv "$VENV"
                    "$VENV/bin/python" -m pip install --upgrade pip
                    "$VENV/bin/python" -m pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '"$VENV/bin/python" -m unittest discover -s . -p "test_*.py" -v'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Copying application files to the deployment directory...'
                sh '''
                    mkdir -p "$DEPLOY_DIR"
                    cp app.py requirements.txt "$DEPLOY_DIR/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting the Flask application...'
                sh '''
                    cd "$DEPLOY_DIR"

                    if [ -f app.pid ]; then
                        OLD_PID=$(cat app.pid)
                        kill "$OLD_PID" 2>/dev/null || true
                    fi

                    nohup "../$VENV/bin/python" app.py > app.log 2>&1 &
                    echo $! > app.pid
                    sleep 3

                    if ! kill -0 "$(cat app.pid)" 2>/dev/null; then
                        cat app.log
                        exit 1
                    fi
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Checking the deployed application over HTTP...'
                sh '''
                    "$VENV/bin/python" - <<'PY'
import time
import urllib.request

url = "http://127.0.0.1:5000/"
last_error = None

for attempt in range(10):
    try:
        with urllib.request.urlopen(url, timeout=3) as response:
            body = response.read().decode("utf-8")
            assert response.status == 200, f"Unexpected status: {response.status}"
            assert body == "Hello, Jenkins Multi-Stage Pipeline!", f"Unexpected body: {body}"
            print("HTTP status:", response.status)
            print("Response:", body)
            break
    except Exception as error:
        last_error = error
        time.sleep(1)
else:
    raise SystemExit(f"Application HTTP test failed: {last_error}")
PY
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the Console Output.'
        }
        always {
            echo 'Jenkins pipeline execution finished.'
        }
    }
}
